{
  "name": "nexus-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run lint",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run test",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
