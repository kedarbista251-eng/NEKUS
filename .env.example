# ==============================================================================
# NEXUS PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with appropriate values.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.

# NODE & RUNTIME
NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# SECURITY & AUTHENTICATION (Better Auth)
BETTER_AUTH_SECRET=your-32-character-secret-key-must-be-random
BETTER_AUTH_URL=http://localhost:4000

# RELATIONAL DATABASE (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus
DATABASE_MAX_CONNECTIONS=20

# CACHE & EPHEMERAL COORDINATION (Redis)
REDIS_URL=redis://localhost:6379

# DURABLE WORKFLOW ORCHESTRATION (Temporal)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexus-main-queue

# AWS INTEGRATION ROLES & CREDS
AWS_REGION=us-east-1
AWS_EXTERNAL_ID_SALT=your-random-external-id-salt-for-tenants

# INTELLIGENCE SERVICE (FastAPI)
INTELLIGENCE_SERVICE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_API_KEY=internal-service-shared-token

# MODEL PROVIDER CONFIGURATION (Optional/Stage 7)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_BEDROCK_ASSUME_ROLE_ARN=

# TELEMETRY & OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nexus-api
